# ─── Server ───────────────────────────────────────────
PORT=5051
ENV=development
LOG_LEVEL=info
WORKERS=1

# ─── Auth ─────────────────────────────────────────────
# Inbound requests (Aggregation -> Media) and outbound CMS write-back use
# different credentials in production. MEDIA_SERVICE_TOKEN_PREVIOUS permits a
# short inbound rotation overlap; remove it after callers have rotated.
# SERVICE_AUTH_TOKEN is a development-compatible alias for MEDIA_SERVICE_TOKEN.
SERVICE_AUTH_TOKEN=
MEDIA_SERVICE_TOKEN=your-media-inbound-token
MEDIA_SERVICE_TOKEN_PREVIOUS=
DATABASE_MIGRATION_COORDINATOR_SERVICE_TOKEN=your-dedicated-migration-coordinator-token
# Dedicated Media principal for CMS transcript/image-vector write-back.
CMS_MEDIA_SERVICE_TOKEN=your-cms-media-service-token
# CMS_SERVICE_TOKEN=legacy-local-token
CMS_BASE_URL=http://localhost:8080
MEDIA_ROLE=api

# ─── STT engine ───────────────────────────────────────
# Which speech-to-text engine boots. 'deepgram' (Nova-3, Arabic dialect
# coverage — the default) or 'whisper' (offline faster-whisper fallback).
# Deepgram falls back to whisper automatically if DEEPGRAM_API_KEY is empty.
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# 'multi' enables code-switching (Arabic+English); or pin to 'ar' / 'en'.
STT_DEFAULT_LANGUAGE=multi

# ─── Models ───────────────────────────────────────────
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
CLIP_MODEL=clip-ViT-B-32
# Optional immutable Hugging Face commit digest. Empty auto-resolves the loaded snapshot.
CLIP_MODEL_REVISION=
MODELS_DIR=./models

# ─── Media handling ───────────────────────────────────
# Where the API spools uploaded audio/image files. The arq worker
# must be able to read from this path (shared volume in containerized
# deploys; same filesystem in dev).
MEDIA_TEMP_DIR=
MAX_UPLOAD_MB=200

# ─── Circuit Breaker (CMS write-back) ─────────────────
CB_FAILURE_THRESHOLD=5
CB_RESET_TIMEOUT_SEC=30
CB_HALF_OPEN_REQUESTS=3

# ─── Timeouts ────────────────────────────────────────
TRANSCRIBE_TIMEOUT_SEC=600
CMS_REQUEST_TIMEOUT_SEC=10

# ─── Redis (arq job queue) ───────────────────────────
# Shared Redis instance with logical DB isolation.
#   db=0 → Aggregation BullMQ
#   db=1 → Enrichment LLM cache
#   db=2 → Media arq job queue (this service)
REDIS_URL=redis://localhost:6379
ARQ_REDIS_DB=2

# ─── Object storage (Cloudflare R2 / S3-compatible) ──
# Async-transcription spool: the API streams uploaded audio here and enqueues
# the object key; the separate worker downloads it. Both media-service-api and
# media-service-worker need these. Leave empty to disable async file uploads
# (sync transcribe + url-based jobs still work). Region is "auto" for R2.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_CDN_URL=
S3_REGION=auto

# ─── CORS ────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=*
